# Komet TV Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=komet123
SECRET_KEY=change-me-to-a-random-string

# Paths (inside container)
DATABASE_PATH=/app/data/komet-tv.db
MEDIA_PATH=/app/media

# Player settings
PLAYLIST_REFRESH_SECONDS=30

# Display durations (seconds)
DISPLAY_DURATION_IMAGE=5
DISPLAY_DURATION_ANNOUNCEMENT=15
DISPLAY_DURATION_SPONSOR=10

# Upload limits (bytes)
MAX_IMAGE_SIZE=10485760
MAX_VIDEO_SIZE=209715200
